# Copy to .env.local for local development. Never commit real values.
#
# Phase 1 needs only the first three values. Everything else is documented here
# so the complete surface is visible from the start; nothing uses a variable
# before the phase that introduces it.

# --- Database (Neon Postgres, founder-owned account, Free plan) --------------
# Pooled connection string used by the running application (PgBouncer).
DATABASE_URL=
# Direct connection string, used only by `payload migrate`.
DATABASE_URL_UNPOOLED=

# --- Payload ----------------------------------------------------------------
# 32+ random bytes. Must differ per environment.
PAYLOAD_SECRET=

# --- Site -------------------------------------------------------------------
# Canonical origin. https://lumiereindex.com in production, the deployment URL
# in preview. Used for canonical links, sitemap and absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Preview / draft mode (Phase 3) -----------------------------------------
# Signs short-lived draft-mode tokens. Never publish through this route.
PREVIEW_SECRET=

# --- Scheduling (Phase 4) ---------------------------------------------------
# Bearer token the external scheduler presents to the jobs runner endpoints.
# Vercel Cron supplies it automatically if we ever move to native cron.
CRON_SECRET=

# --- Media (Phase 3) --------------------------------------------------------
# local | vercel-blob | s3. Production refuses "local".
# The vendor is chosen in Phase 3; no storage vendor is a dependency today.
MEDIA_STORAGE_ADAPTER=local
# Only if the Phase 3 decision is Vercel Blob:
BLOB_READ_WRITE_TOKEN=
# Only if the Phase 3 decision is S3-compatible storage (for example R2):
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Newsletter (Phase 5) ---------------------------------------------------
# Delivery stays unclaimed until a provider is configured and tested.
RESEND_API_KEY=
EMAIL_FROM=
