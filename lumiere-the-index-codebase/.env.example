# =============================================================================
# Lumière Frontend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# For Vercel: set these in the Vercel dashboard → Settings → Environment Variables.
# =============================================================================

# Backend API URL — REQUIRED for production
# Local dev:  http://localhost:8000
# Production: https://lumiere-index-production.up.railway.app
VITE_API_BASE_URL=http://localhost:8000

# TMDB image proxy (optional, only needed if bypassing backend proxy)
# VITE_TMDB_API_KEY=
