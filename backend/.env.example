# =============================================================================
# Lumière Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Railway / Heroku / Render provide DATABASE_URL and individual MYSQL* vars
# automatically when you attach a MySQL plugin. The app reads either format.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Option A: Full connection URL (provided by Railway / Heroku / Render)
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/db?charset=utf8mb4
#
# Option B: Individual vars (Docker Compose / manual setup)
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_USER=lumiere
# MYSQL_PASSWORD=
# MYSQL_DB=lumiere

# --- Redis -------------------------------------------------------------------
# Railway / Render provide REDIS_URL automatically.
# REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=

# --- CORS --------------------------------------------------------------------
# Comma-separated origins allowed to call the API.
# The Vercel frontend is included by default; add more as needed.
# CORS_ORIGINS=http://localhost:8080,https://lumiere-index.vercel.app

# --- API Keys ----------------------------------------------------------------
# Provide the ones you have; leave blank to disable that ingest source.
# TMDB_API_KEY=
# NEWSAPI_KEY=
# YOUTUBE_API_KEY=
# RAPIDAPI_KEY=
# RAPIDAPI_TIKTOK_HOST=

# --- App Settings (optional) -------------------------------------------------
# API_HOST=0.0.0.0
# API_PORT=8000
# ADMIN_KEY=
# DISCOVERY_BATCH_SIZE=50
# TMDB_SEARCH_PER_RUN=30
# RANKING_HALF_LIFE_HOURS=24.0
# RANKING_WINDOW_HOURS=48.0
# REFRESH_INTERVAL_MINUTES=15
